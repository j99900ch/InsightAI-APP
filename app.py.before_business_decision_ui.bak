"""
===========================================================
InsightAI - Main Application
-----------------------------------------------------------
Application entry point.

Responsibilities
----------------
- Configure Streamlit
- Initialize session state
- Render sidebar
- Route application pages
===========================================================
"""

from __future__ import annotations

import streamlit as st

import config.settings as settings

from config.settings import (
    PAGE_TITLE,
    PAGE_ICON,
    LAYOUT,
    INITIAL_SIDEBAR_STATE,
)

from core.session_defaults import SESSION_DEFAULTS

from components.sidebar import (
    init_sidebar_state,
    render_sidebar,
)

import components.dashboard as dashboard
import components.overview as overview
import components.uploader as uploader
import components.statistics_ui as statistics_ui
import components.charts_ui as charts_ui
import components.cleaning_ui as cleaning_ui
import components.prediction_ui as prediction_ui
import components.report_ui as report_ui
import components.insights_ui as insights_ui
import components.export_ui as export_ui
import components.voice_ui as voice_ui


# ===========================================================
# DEBUG INFORMATION
# ===========================================================

print("=" * 60)
print(
    "DEBUG SETTINGS FILE:",
    settings.__file__,
)
print(
    "DEBUG PAGE_ICON:",
    settings.PAGE_ICON,
)
print(
    "DEBUG INITIAL_SIDEBAR_STATE:",
    settings.INITIAL_SIDEBAR_STATE,
)
print("=" * 60)


# ===========================================================
# STREAMLIT CONFIGURATION
# ===========================================================

st.set_page_config(
    page_title=PAGE_TITLE,
    page_icon=PAGE_ICON,
    layout=LAYOUT,
    initial_sidebar_state=INITIAL_SIDEBAR_STATE,
)


# ===========================================================
# SESSION STATE
# ===========================================================

init_sidebar_state()

for key, value in SESSION_DEFAULTS.items():

    if key not in st.session_state:

        st.session_state[key] = value


# ===========================================================
# SIDEBAR
# ===========================================================

page = render_sidebar()


# ===========================================================
# PAGE ROUTING
# ===========================================================

if page == "Home":

    dashboard.render_dashboard()


elif page == "Dataset Overview":

    uploaded_df = uploader.render_uploader()

    if uploaded_df is not None:

        st.session_state.df = uploaded_df

        st.session_state.data_loaded = True

        st.session_state.filename = (
            st.session_state.uploaded_file_name
        )

        from analysis import (
            dataset_profile,
            business_summary,
        )

        st.session_state.profile = (
            dataset_profile(
                uploaded_df
            )
        )

        st.session_state.dataset_summary = (
            business_summary(
                uploaded_df
            )
        )

    overview.render_overview()


elif page == "Statistics":

    statistics_ui.render_statistics_ui()


elif page == "Charts":

    charts_ui.render_charts_ui()


elif page == "Data Cleaning":

    cleaning_ui.render_cleaning_ui()


elif page == "Machine Learning":

    prediction_ui.render_prediction_ui()


elif page == "Business Insights":

    insights_ui.render_insights_ui()


elif page == "Voice Assistant":

    voice_ui.render_voice_ui()


elif page == "PDF Report":

    report_ui.render_report_ui()


elif page == "Export":

    export_ui.render_export_ui()


else:

    st.error(
        f"Unknown page: {page}"
    )