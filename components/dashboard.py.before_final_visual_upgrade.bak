                    );
            }

            .insight-hero-badge {
                display: inline-block;
                padding: 0.35rem 0.75rem;
                border-radius: 999px;
                font-size: 0.78rem;
                font-weight: 700;
                letter-spacing: 0.04em;
                border: 1px solid rgba(128, 128, 128, 0.25);
                margin-bottom: 0.9rem;
            }

            .insight-hero-title {
                font-size: clamp(2rem, 4vw, 3.4rem);
                line-height: 1.05;
                font-weight: 800;
                margin: 0;
                letter-spacing: -0.04em;
            }

            .insight-hero-subtitle {
                font-size: 1.05rem;
