"""
===========================================================
InsightAI - Dashboard Component
-----------------------------------------------------------
Professional application dashboard.

Responsibilities
-----------------
- Render the InsightAI home dashboard
- Display application status
- Display dataset overview
- Display available analytics capabilities
- Display dataset summary
- Preserve existing session-state behavior

This module only renders the dashboard.
It NEVER changes navigation or page routing.
===========================================================
"""

from __future__ import annotations

from textwrap import dedent

import streamlit as st


