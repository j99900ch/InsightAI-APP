            background:
                linear-gradient(
                    135deg,
                    rgba(37, 99, 235, 0.15),
                    rgba(124, 58, 237, 0.12)
                );
        }

        .voice-badge {
            display: inline-block;
            padding: 0.35rem 0.75rem;
            border-radius: 999px;
            font-size: 0.72rem;
            font-weight: 800;
            letter-spacing: 0.08em;
            margin-bottom: 0.8rem;
            background: rgba(37, 99, 235, 0.12);
        }

        .voice-title {
            font-size: clamp(2rem, 4vw, 3rem);
            font-weight: 850;
            letter-spacing: -0.04em;
            line-height: 1.05;
        }

        .voice-subtitle {
            margin-top: 0.75rem;
            max-width: 800px;
            line-height: 1.65;
            opacity: 0.72;
        }

        .voice-card {
            padding: 1.4rem;
            border-radius: 20px;
            border: 1px solid rgba(128, 128, 128, 0.18);
            background: rgba(128, 128, 128, 0.045);
            min-height: 150px;
        }

        .voice-card-icon {
            font-size: 2rem;
            margin-bottom: 0.5rem;
        }

        .voice-card-title {
            font-weight: 800;
