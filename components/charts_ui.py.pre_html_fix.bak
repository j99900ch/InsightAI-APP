"""
===========================================================
InsightAI - Advanced Charts UI
-----------------------------------------------------------
Modern interactive visualization dashboard.

Preserves:
- Existing chart functions
- Automated chart recommendation engine
- Sample dataset fallback
- Existing session-state behavior
- Existing chart types

Adds:
- Modern dashboard layout
- KPI overview
- Interactive Plotly controls
- Professional visualization cards
- Automated visualization intelligence
- Correlation insights
- Dataset health indicators
- Better chart explanations
===========================================================
"""

from __future__ import annotations

import pandas as pd
import plotly.express as px
import plotly.figure_factory as ff
import streamlit as st


# ===========================================================
# SESSION STATE
# ===========================================================

def init_charts_state() -> None:
    """Initialize missing chart session-state values."""

    defaults = {
        "df": None,
        "uploaded_file_name": None,
        "dataset_summary": {},
        "charts_message": "Charts ready.",
        "charts_auto_generated": False,
    }

    for key, value in defaults.items():
        if key not in st.session_state:
            st.session_state[key] = value


# ===========================================================
# SAMPLE DATASET
# ===========================================================

def build_sample_dataframe() -> pd.DataFrame:
    """Return a safe sample dataframe."""

    return pd.DataFrame(
        {
            "Sales": [120, 210, 180, 300, 250],
            "Profit": [22, 41, 35, 60, 48],
            "Quantity": [5, 8, 6, 12, 9],
            "Category": [
                "Electronics",
                "Furniture",
                "Electronics",
                "Office",
                "Furniture",
            ],
        }
    )


# ===========================================================
# COLUMN HELPERS
# ===========================================================

def get_numeric_columns(
    df: pd.DataFrame,
) -> list[str]:
    """Return numeric columns."""

    return (
        df.select_dtypes(include="number")
        .columns
        .tolist()
    )


def get_categorical_columns(
    df: pd.DataFrame,
) -> list[str]:
    """Return categorical columns."""

    return (
        df.select_dtypes(
            include=[
                "object",
                "category",
                "string",
                "bool",
            ]
        )
        .columns
        .tolist()
    )


def get_datetime_columns(
    df: pd.DataFrame,
) -> list[str]:
    """Return datetime columns."""

    return (
        df.select_dtypes(
            include=[
                "datetime",
                "datetimetz",
            ]
        )
        .columns
        .tolist()
    )


# ===========================================================
# CHART CANDIDATE ENGINE
# ===========================================================

def get_chart_candidate_columns(
    df: pd.DataFrame,
) -> tuple[
    list[str],
    list[str],
    list[str],
]:
    """
    Identify useful columns for automated visualization.

    Returns
    -------
    tuple
        numeric_columns,
        categorical_columns,
        datetime_columns
    """

    numeric_columns = get_numeric_columns(df)

    categorical_columns = get_categorical_columns(df)

    datetime_columns = get_datetime_columns(df)

    # -------------------------------------------------------
    # Remove obvious ID-like numeric columns
    # -------------------------------------------------------

    filtered_numeric = []

    for column in numeric_columns:

        unique_ratio = (
            df[column].nunique(dropna=True)
            / max(len(df), 1)
        )

        column_name = column.lower()

        looks_like_id = (
            column_name == "id"
            or column_name.endswith("_id")
            or column_name.endswith("id")
            or "identifier" in column_name
        )

        if (
            not looks_like_id
            and unique_ratio < 0.98
        ):
            filtered_numeric.append(column)

    if filtered_numeric:
        numeric_columns = filtered_numeric

    # -------------------------------------------------------
    # Remove extremely high-cardinality categories
    # -------------------------------------------------------

    filtered_categorical = []

    for column in categorical_columns:

        unique_count = df[column].nunique(
            dropna=True
        )

        if 2 <= unique_count <= 30:
            filtered_categorical.append(column)

    categorical_columns = filtered_categorical

    return (
        numeric_columns,
        categorical_columns,
        datetime_columns,
    )


# ===========================================================
# AUTOMATED CHART RECOMMENDATION ENGINE
# ===========================================================

def recommend_automated_charts(
    df: pd.DataFrame,
) -> list[dict[str, str]]:
    """
    Automatically recommend useful visualizations.
    """

    (
        numeric_columns,
        categorical_columns,
        datetime_columns,
    ) = get_chart_candidate_columns(df)

    recommendations: list[
        dict[str, str]
    ] = []

    # -------------------------------------------------------
    # TIME SERIES
    # -------------------------------------------------------

    if (
        datetime_columns
        and numeric_columns
    ):

        datetime_column = datetime_columns[0]

        numeric_column = numeric_columns[0]

        recommendations.append(
            {
                "type": "Line Chart",
                "title": (
                    f"{numeric_column} Trend Over Time"
                ),
                "x": datetime_column,
                "y": numeric_column,
                "reason": (
                    "A datetime column and numeric measure "
                    "were detected, making a trend chart "
                    "useful for understanding changes over time."
                ),
            }
        )

    # -------------------------------------------------------
    # CATEGORY + NUMERIC
    # -------------------------------------------------------

    if (
        categorical_columns
        and numeric_columns
    ):

        category = categorical_columns[0]

        value = numeric_columns[0]

        recommendations.append(
            {
                "type": "Bar Chart",
                "title": (
                    f"{value} by {category}"
                ),
                "x": category,
                "y": value,
                "reason": (
                    "A categorical dimension and numeric "
                    "measure were detected, making this "
                    "useful for business comparison."
                ),
            }
        )

    # -------------------------------------------------------
    # NUMERIC RELATIONSHIP
    # -------------------------------------------------------

    if len(numeric_columns) >= 2:

        x_axis = numeric_columns[0]

        y_axis = numeric_columns[1]

        best_pair = None

        best_correlation = -1.0

        for i, column_x in enumerate(
            numeric_columns
        ):

            for column_y in numeric_columns[
                i + 1:
            ]:

                correlation = (
                    df[
                        [
                            column_x,
                            column_y,
                        ]
                    ]
                    .corr()
                    .iloc[0, 1]
                )

                if pd.notna(correlation):

                    absolute_correlation = abs(
                        float(correlation)
                    )

                    if (
                        absolute_correlation
                        > best_correlation
                    ):

                        best_correlation = (
                            absolute_correlation
                        )

                        best_pair = (
                            column_x,
                            column_y,
                        )

        if best_pair is not None:

            x_axis, y_axis = best_pair

        recommendations.append(
            {
                "type": "Scatter Plot",
                "title": (
                    f"{x_axis} vs {y_axis}"
                ),
                "x": x_axis,
                "y": y_axis,
                "reason": (
                    "Two numeric measures were detected. "
                    "The selected pair has the strongest "
                    "measurable relationship."
                ),
            }
        )

    # -------------------------------------------------------
    # NUMERIC FALLBACK
    # -------------------------------------------------------

    if (
        not recommendations
        and numeric_columns
    ):

        column = numeric_columns[0]

        recommendations.append(
            {
                "type": "Histogram",
                "title": (
                    f"Distribution of {column}"
                ),
                "x": column,
                "y": "",
                "reason": (
                    "A numeric feature was detected. "
                    "A distribution chart helps identify "
                    "spread, concentration and unusual values."
                ),
            }
        )

    # -------------------------------------------------------
    # CATEGORICAL FALLBACK
    # -------------------------------------------------------

    if (
        not recommendations
        and categorical_columns
    ):

        column = categorical_columns[0]

        recommendations.append(
            {
                "type": "Count Plot",
                "title": (
                    f"{column} Distribution"
                ),
                "x": column,
                "y": "",
                "reason": (
                    "A categorical feature was detected. "
                    "A count chart shows the distribution "
                    "across categories."
                ),
            }
        )

    return recommendations[:3]


# ===========================================================
# PLOTLY PROFESSIONAL CONFIGURATION
# ===========================================================

def apply_chart_layout(
    fig,
    title: str | None = None,
) -> None:
    """Apply consistent professional Plotly styling."""

    fig.update_layout(
        title=title,
        title_x=0.02,
        title_font_size=20,
        height=500,
        margin=dict(
            l=30,
            r=30,
            t=70,
            b=30,
        ),
        hovermode="closest",
        legend=dict(
            orientation="h",
            yanchor="bottom",
            y=1.02,
            xanchor="right",
            x=1,
        ),
    )

    fig.update_xaxes(
        showgrid=True,
        zeroline=False,
    )

    fig.update_yaxes(
        showgrid=True,
        zeroline=False,
    )


def display_chart(
    fig,
) -> None:
    """Render Plotly chart consistently."""

    st.plotly_chart(
        fig,
        use_container_width=True,
        config={
            "displaylogo": False,
            "responsive": True,
            "scrollZoom": True,
            "displayModeBar": True,
        },
    )


# ===========================================================
# AUTOMATED CHART RENDERER
# ===========================================================

def render_automated_charts(
    df: pd.DataFrame,
) -> None:
    """Render automatically recommended charts."""

    recommendations = recommend_automated_charts(
        df
    )

    if not recommendations:

        st.warning(
            "InsightAI could not identify suitable "
            "automated visualizations for this dataset."
        )

        return

    st.markdown(
        "## ✦ AI Visualization Recommendations"
    )

    st.caption(
        "InsightAI analyzed your dataset structure "
        "and selected high-value visualizations."
    )

    for index, recommendation in enumerate(
        recommendations,
        start=1,
    ):

        st.markdown(
            f"""
            <div style="
                padding: 18px;
                border-radius: 14px;
                border: 1px solid rgba(128,128,128,0.25);
                margin: 12px 0;
            ">
                <div style="
                    font-size: 13px;
                    opacity: 0.7;
                    margin-bottom: 5px;
                ">
                    RECOMMENDATION {index}
                </div>

                <div style="
                    font-size: 21px;
                    font-weight: 700;
                ">
                    {recommendation["title"]}
                </div>

                <div style="
                    margin-top: 7px;
                    opacity: 0.75;
                ">
                    {recommendation["type"]}
                </div>
            </div>
            """,
            unsafe_allow_html=True,
        )

        chart_type = recommendation["type"]

        # ---------------------------------------------------
        # LINE
        # ---------------------------------------------------

        if chart_type == "Line Chart":

            chart_df = (
                df[
                    [
                        recommendation["x"],
                        recommendation["y"],
                    ]
                ]
                .dropna()
                .sort_values(
                    recommendation["x"]
                )
            )

            fig = px.line(
                chart_df,
                x=recommendation["x"],
                y=recommendation["y"],
                markers=True,
                title=recommendation["title"],
            )

            apply_chart_layout(fig)

            display_chart(fig)

        # ---------------------------------------------------
        # BAR
        # ---------------------------------------------------

        elif chart_type == "Bar Chart":

            grouped = (
                df[
                    [
                        recommendation["x"],
                        recommendation["y"],
                    ]
                ]
                .dropna()
                .groupby(
                    recommendation["x"]
                )[
                    recommendation["y"]
                ]
                .sum()
                .reset_index()
                .sort_values(
                    recommendation["y"],
                    ascending=False,
                )
                .head(15)
            )

            fig = px.bar(
                grouped,
                x=recommendation["x"],
                y=recommendation["y"],
                title=recommendation["title"],
                text_auto=".2s",
            )

            apply_chart_layout(fig)

            display_chart(fig)

        # ---------------------------------------------------
        # SCATTER
        # ---------------------------------------------------

        elif chart_type == "Scatter Plot":

            chart_df = (
                df[
                    [
                        recommendation["x"],
                        recommendation["y"],
                    ]
                ]
                .dropna()
            )

            fig = px.scatter(
                chart_df,
                x=recommendation["x"],
                y=recommendation["y"],
                title=recommendation["title"],
                trendline="ols",
            )

            apply_chart_layout(fig)

            display_chart(fig)

        # ---------------------------------------------------
        # HISTOGRAM
        # ---------------------------------------------------

        elif chart_type == "Histogram":

            fig = px.histogram(
                df,
                x=recommendation["x"],
                nbins=30,
                title=recommendation["title"],
            )

            apply_chart_layout(fig)

            display_chart(fig)

        # ---------------------------------------------------
        # COUNT PLOT
        # ---------------------------------------------------

        elif chart_type == "Count Plot":

            fig = px.histogram(
                df,
                x=recommendation["x"],
                title=recommendation["title"],
            )

            apply_chart_layout(fig)

            display_chart(fig)

        st.info(
            f"Why this visualization was selected: "
            f"{recommendation['reason']}"
        )

        if index < len(recommendations):

            st.divider()


# ===========================================================
# DASHBOARD HEADER
# ===========================================================

def render_chart_header(
    df: pd.DataFrame,
) -> None:
    """Render modern dashboard header."""

    file_name = (
        st.session_state.uploaded_file_name
        or "Sample Dataset"
    )

    st.markdown(
        """
        <div style="
            padding: 8px 0 4px 0;
        ">
            <div style="
                font-size: 34px;
                font-weight: 800;
            ">
                Visualization Studio
            </div>

            <div style="
                font-size: 15px;
                opacity: 0.65;
                margin-top: 5px;
            ">
                Explore patterns, relationships and
                business signals hidden inside your data.
            </div>
        </div>
        """,
        unsafe_allow_html=True,
    )

    st.caption(
        f"Active dataset • {file_name}"
    )

    rows, columns = df.shape

    numeric_count = len(
        get_numeric_columns(df)
    )

    categorical_count = len(
        get_categorical_columns(df)
    )

    missing_count = int(
        df.isna().sum().sum()
    )

    c1, c2, c3, c4 = st.columns(4)

    with c1:
        st.metric(
            "Records",
            f"{rows:,}",
        )

    with c2:
        st.metric(
            "Features",
            f"{columns:,}",
        )

    with c3:
        st.metric(
            "Numeric Signals",
            f"{numeric_count:,}",
        )

    with c4:
        st.metric(
            "Missing Values",
            f"{missing_count:,}",
        )

    st.divider()


# ===========================================================
# CHART TYPE SELECTOR
# ===========================================================

def render_chart_selector() -> str:
    """Render modern chart selector."""

    st.markdown(
        "### Visualization Builder"
    )

    st.caption(
        "Choose a visualization and configure "
        "its dimensions below."
    )

    chart_types = [
        "Histogram",
        "Box Plot",
        "Scatter Plot",
        "Correlation Heatmap",
        "Count Plot",
        "Bar Plot",
        "Pie Chart",
        "Line Chart",
        "Area Chart",
    ]

    return st.selectbox(
        "Chart Type",
        chart_types,
        key="advanced_chart_type",
    )


# ===========================================================
# MAIN UI
# ===========================================================

def render_charts_ui() -> None:
    """Render advanced interactive Charts Dashboard."""

    init_charts_state()

    # -------------------------------------------------------
    # Dataset
    # -------------------------------------------------------

    if (
        st.session_state.df is not None
        and not st.session_state.df.empty
    ):

        df = st.session_state.df

    else:

        df = build_sample_dataframe()

        st.warning(
            "No dataset uploaded. InsightAI is displaying "
            "a sample dataset for visualization."
        )

    # -------------------------------------------------------
    # Header
    # -------------------------------------------------------

    render_chart_header(df)

    numeric_columns = get_numeric_columns(df)

    categorical_columns = (
        get_categorical_columns(df)
    )

    if not numeric_columns:

        st.error(
            "No numeric columns are available "
            "for visualization."
        )

        return

    # =======================================================
    # AI RECOMMENDATIONS
    # =======================================================

    with st.container(
        border=True
    ):

        st.markdown(
            "### ✦ Intelligent Visualization"
        )

        st.caption(
            "Let InsightAI automatically identify "
            "the most useful visual patterns."
        )

        generate_col, status_col = st.columns(
            [2, 1]
        )

        with generate_col:

            generate = st.button(
                "Generate AI Visualizations",
                use_container_width=True,
                type="primary",
            )

        with status_col:

            st.caption(
                "Up to 3 recommended charts"
            )

    if generate:

        st.session_state.charts_auto_generated = True

    if st.session_state.charts_auto_generated:

        render_automated_charts(df)

        st.divider()

    # =======================================================
    # MANUAL VISUALIZATION BUILDER
    # =======================================================

    chart_type = render_chart_selector()

    st.divider()

    # =======================================================
    # HISTOGRAM
    # =======================================================

    if chart_type == "Histogram":

        with st.container(border=True):

            column = st.selectbox(
                "Numeric Feature",
                numeric_columns,
                key="hist_column",
            )

            bins = st.slider(
                "Number of bins",
                min_value=5,
                max_value=100,
                value=30,
                key="hist_bins",
            )

            fig = px.histogram(
                df,
                x=column,
                nbins=bins,
                title=f"Distribution of {column}",
            )

            apply_chart_layout(fig)

            display_chart(fig)

    # =======================================================
    # BOX PLOT
    # =======================================================

    elif chart_type == "Box Plot":

        with st.container(border=True):

            column = st.selectbox(
                "Numeric Feature",
                numeric_columns,
                key="box_column",
            )

            fig = px.box(
                df,
                y=column,
                title=f"Distribution & Outliers • {column}",
                points="outliers",
            )

            apply_chart_layout(fig)

            display_chart(fig)

            st.caption(
                "Use this view to identify spread, "
                "quartiles and potential outliers."
            )

    # =======================================================
    # SCATTER
    # =======================================================

    elif chart_type == "Scatter Plot":

        with st.container(border=True):

            left, right = st.columns(2)

            with left:

                x_axis = st.selectbox(
                    "X Axis",
                    numeric_columns,
                    key="scatter_x",
                )

            with right:

                y_axis = st.selectbox(
                    "Y Axis",
                    numeric_columns,
                    index=min(
                        1,
                        len(numeric_columns) - 1,
                    ),
                    key="scatter_y",
                )

            trendline = st.checkbox(
                "Show trendline",
                value=True,
                key="scatter_trendline",
            )

            fig = px.scatter(
                df,
                x=x_axis,
                y=y_axis,
                title=f"{x_axis} vs {y_axis}",
                trendline=(
                    "ols"
                    if trendline
                    else None
                ),
            )

            apply_chart_layout(fig)

            display_chart(fig)

            correlation = (
                df[
                    [
                        x_axis,
                        y_axis,
                    ]
                ]
                .corr()
                .iloc[0, 1]
            )

            if pd.notna(correlation):

                st.metric(
                    "Correlation",
                    f"{float(correlation):.3f}",
                )

    # =======================================================
    # CORRELATION HEATMAP
    # =======================================================

    elif chart_type == "Correlation Heatmap":

        with st.container(border=True):

            correlation = (
                df[numeric_columns]
                .corr()
                .round(2)
            )

            if len(
                correlation.columns
            ) < 2:

                st.info(
                    "At least two numeric columns "
                    "are required."
                )

            else:

                fig = ff.create_annotated_heatmap(
                    z=correlation.values,
                    x=list(
                        correlation.columns
                    ),
                    y=list(
                        correlation.index
                    ),
                    annotation_text=(
                        correlation.values
                        .astype(str)
                    ),
                    colorscale="Viridis",
                    showscale=True,
                )

                fig.update_layout(
                    title="Feature Correlation Matrix",
                    title_x=0.02,
                    height=600,
                    margin=dict(
                        l=30,
                        r=30,
                        t=70,
                        b=30,
                    ),
                )

                display_chart(fig)

    # =======================================================
    # COUNT PLOT
    # =======================================================

    elif chart_type == "Count Plot":

        if not categorical_columns:

            st.warning(
                "No categorical columns available."
            )

        else:

            with st.container(
                border=True
            ):

                column = st.selectbox(
                    "Categorical Feature",
                    categorical_columns,
                    key="count_column",
                )

                fig = px.histogram(
                    df,
                    x=column,
                    title=f"Frequency Distribution • {column}",
                )

                apply_chart_layout(fig)

                display_chart(fig)

    # =======================================================
    # BAR PLOT
    # =======================================================

    elif chart_type == "Bar Plot":

        if not categorical_columns:

            st.warning(
                "No categorical columns available."
            )

        else:

            with st.container(
                border=True
            ):

                left, right = st.columns(2)

                with left:

                    category = st.selectbox(
                        "Category",
                        categorical_columns,
                        key="bar_category",
                    )

                with right:

                    value = st.selectbox(
                        "Measure",
                        numeric_columns,
                        key="bar_value",
                    )

                grouped = (
                    df.groupby(
                        category
                    )[value]
                    .sum()
                    .reset_index()
                    .sort_values(
                        value,
                        ascending=False,
                    )
                    .head(20)
                )

                fig = px.bar(
                    grouped,
                    x=category,
                    y=value,
                    title=(
                        f"{value} by {category}"
                    ),
                    text_auto=".2s",
                )

                apply_chart_layout(fig)

                display_chart(fig)

    # =======================================================
    # PIE CHART
    # =======================================================

    elif chart_type == "Pie Chart":

        if not categorical_columns:

            st.warning(
                "No categorical columns available."
            )

        else:

            with st.container(
                border=True
            ):

                category = st.selectbox(
                    "Category",
                    categorical_columns,
                    key="pie_category",
                )

                pie_data = (
                    df[category]
                    .value_counts()
                    .reset_index()
                )

                pie_data.columns = [
                    category,
                    "Count",
                ]

                fig = px.pie(
                    pie_data,
                    names=category,
                    values="Count",
                    hole=0.45,
                    title=(
                        f"Composition • {category}"
                    ),
                )

                fig.update_traces(
                    textposition="inside",
                    textinfo="percent+label",
                )

                apply_chart_layout(fig)

                display_chart(fig)

    # =======================================================
    # LINE CHART
    # =======================================================

    elif chart_type == "Line Chart":

        with st.container(
            border=True
        ):

            left, right = st.columns(2)

            with left:

                x_axis = st.selectbox(
                    "X Axis",
                    df.columns,
                    key="line_x",
                )

            with right:

                y_axis = st.selectbox(
                    "Y Axis",
                    numeric_columns,
                    key="line_y",
                )

            chart_df = (
                df[
                    [
                        x_axis,
                        y_axis,
                    ]
                ]
                .dropna()
            )

            if (
                pd.api.types.is_datetime64_any_dtype(
                    chart_df[x_axis]
                )
            ):

                chart_df = chart_df.sort_values(
                    x_axis
                )

            fig = px.line(
                chart_df,
                x=x_axis,
                y=y_axis,
                title=(
                    f"{y_axis} Trend"
                ),
                markers=True,
            )

            apply_chart_layout(fig)

            display_chart(fig)

    # =======================================================
    # AREA CHART
    # =======================================================

    elif chart_type == "Area Chart":

        with st.container(
            border=True
        ):

            left, right = st.columns(2)

            with left:

                x_axis = st.selectbox(
                    "X Axis",
                    df.columns,
                    key="area_x",
                )

            with right:

                y_axis = st.selectbox(
                    "Y Axis",
                    numeric_columns,
                    key="area_y",
                )

            fig = px.area(
                df,
                x=x_axis,
                y=y_axis,
                title=(
                    f"{y_axis} Trend Area"
                ),
            )

            apply_chart_layout(fig)

            display_chart(fig)

    # =======================================================
    # DATASET SUMMARY
    # =======================================================

    st.divider()

    st.markdown(
        "### Dataset Intelligence"
    )

    summary = st.session_state.dataset_summary

    if summary:

        items = list(
            summary.items()
        )

        columns = st.columns(
            min(4, max(1, len(items)))
        )

        for index, (
            key,
            value,
        ) in enumerate(items):

            with columns[
                index % len(columns)
            ]:

                st.metric(
                    label=(
                        str(key)
                        .replace(
                            "_",
                            " ",
                        )
                        .title()
                    ),
                    value=value,
                )

    else:

        rows = len(df)

        columns_count = len(
            df.columns
        )

        missing = int(
            df.isna().sum().sum()
        )

        duplicate_count = int(
            df.duplicated().sum()
        )

        c1, c2, c3, c4 = st.columns(4)

        c1.metric(
            "Rows",
            f"{rows:,}",
        )

        c2.metric(
            "Columns",
            f"{columns_count:,}",
        )

        c3.metric(
            "Missing",
            f"{missing:,}",
        )

        c4.metric(
            "Duplicates",
            f"{duplicate_count:,}",
        )

    # =======================================================
    # CHART EXPLANATION
    # =======================================================

    st.divider()

    descriptions = {
        "Histogram": (
            "Visualizes the distribution of a numeric "
            "variable and helps reveal concentration, "
            "skewness and unusual observations."
        ),
        "Box Plot": (
            "Summarizes the distribution using quartiles "
            "and highlights potential outliers."
        ),
        "Scatter Plot": (
            "Shows the relationship between two numeric "
            "variables and can reveal correlation patterns."
        ),
        "Correlation Heatmap": (
            "Displays pairwise relationships between "
            "numeric features using correlation values."
        ),
        "Count Plot": (
            "Shows how frequently observations occur "
            "within each category."
        ),
        "Bar Plot": (
            "Compares an aggregated numeric measure "
            "across business categories."
        ),
        "Pie Chart": (
            "Displays the proportional contribution "
            "of categories."
        ),
        "Line Chart": (
            "Highlights movement and trends across "
            "an ordered dimension."
        ),
        "Area Chart": (
            "Emphasizes the magnitude and progression "
            "of a numeric trend."
        ),
    }

    with st.expander(
        "ⓘ Visualization Guide",
        expanded=False,
    ):

        st.write(
            descriptions.get(
                chart_type,
                "Interactive business visualization.",
            )
        )

    # =======================================================
    # FOOTER
    # =======================================================

    st.divider()

    st.caption(
        "InsightAI Visualization Studio • "
        "Interactive Analytics • Version 2.0"
    )