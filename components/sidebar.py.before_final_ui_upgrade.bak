"""
===========================================================
InsightAI - Professional Sidebar
-----------------------------------------------------------
Centralized application sidebar.

Responsibilities
----------------
- Initialize Streamlit session state
- Display professional navigation
- Display dataset/application status
- Provide application controls
- Reset application state

Design Goals
------------
- Modern professional appearance
- Advanced visual hierarchy
- Preserve existing navigation values
- Preserve existing session-state behavior
- No business logic
- No changes to application routing
===========================================================
"""

from __future__ import annotations

import streamlit as st

from config.constants import (
    PAGES,
    DEFAULT_PAGE,
    NAVIGATION,
    APP_VERSION,
)

from core.session_defaults import SESSION_DEFAULTS


# ===========================================================
# SESSION INITIALIZATION
# ===========================================================

def init_sidebar_state() -> None:
    """Initialize Streamlit session state."""

    for key, value in SESSION_DEFAULTS.items():

        if key not in st.session_state:
            st.session_state[key] = value

    if st.session_state.page not in PAGES:
        st.session_state.page = DEFAULT_PAGE


# ===========================================================
# RESET
# ===========================================================

def reset_app_state() -> None:
    """Reset application state to its defaults."""

    st.session_state.clear()

    for key, value in SESSION_DEFAULTS.items():
        st.session_state[key] = value

    st.session_state.page = DEFAULT_PAGE


# ===========================================================
# SIDEBAR STYLE
# ===========================================================

def _inject_sidebar_style() -> None:
    """Inject professional sidebar styling."""

    st.html(
        """
        <style>

        /* =================================================
           SIDEBAR CONTAINER
           ================================================= */

        section[data-testid="stSidebar"] {
            border-right: 1px solid rgba(128, 128, 128, 0.18);
        }

        section[data-testid="stSidebar"] > div {
            padding-top: 1.2rem;
            padding-bottom: 1rem;
        }


        /* =================================================
           BRAND
           ================================================= */

        .insightai-brand {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 4px;
        }

        .insightai-logo {
            width: 42px;
            height: 42px;
            border-radius: 12px;

            display: flex;
            align-items: center;
            justify-content: center;

            font-size: 22px;
            font-weight: 700;

            background:
                linear-gradient(
                    135deg,
                    #2563eb,
                    #7c3aed
                );

            color: white;

            box-shadow:
                0 6px 18px
                rgba(37, 99, 235, 0.25);
        }

        .insightai-title {
            font-size: 1.35rem;
            font-weight: 750;
            letter-spacing: -0.4px;
            line-height: 1.1;
        }

        .insightai-subtitle {
            font-size: 0.73rem;
            opacity: 0.65;
            margin-top: 3px;
        }


        /* =================================================
           SECTION LABEL
           ================================================= */

        .sidebar-section-label {
            font-size: 0.68rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1.2px;
            opacity: 0.55;
            margin-top: 10px;
            margin-bottom: 6px;
        }


        /* =================================================
           STATUS CARD
           ================================================= */

        .dataset-status-card {
            border: 1px solid rgba(128, 128, 128, 0.18);
            border-radius: 14px;

            padding: 13px 14px;

            margin-top: 8px;
            margin-bottom: 10px;

            background:
                rgba(128, 128, 128, 0.055);
        }

        .status-row {
            display: flex;
            align-items: center;
            gap: 9px;
            margin-bottom: 8px;
        }

        .status-row:last-child {
            margin-bottom: 0;
        }

        .status-icon {
            width: 25px;
            height: 25px;
            border-radius: 8px;

            display: flex;
            align-items: center;
            justify-content: center;

            font-size: 13px;

            background:
                rgba(37, 99, 235, 0.10);
        }

        .status-label {
            font-size: 0.68rem;
            opacity: 0.55;
        }

        .status-value {
            font-size: 0.78rem;
            font-weight: 650;
            word-break: break-word;
        }


        /* =================================================
           STATUS BADGE
           ================================================= */

        .status-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;

            padding: 4px 9px;

            border-radius: 999px;

            font-size: 0.68rem;
            font-weight: 700;
        }

        .status-active {
            background: rgba(34, 197, 94, 0.12);
        }

        .status-empty {
            background: rgba(148, 163, 184, 0.12);
        }

        .status-dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: currentColor;
        }


        /* =================================================
           CONTROL AREA
           ================================================= */

        .sidebar-control-title {
            font-size: 0.68rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
            opacity: 0.55;

            margin-top: 8px;
            margin-bottom: 3px;
        }


        /* =================================================
           RESET BUTTON
           ================================================= */

        section[data-testid="stSidebar"]
        button[kind="secondary"] {
            border-radius: 10px;
        }


        /* =================================================
           FOOTER
           ================================================= */

        .insightai-footer {
            text-align: center;
            padding-top: 6px;
        }

        .footer-version {
            font-size: 0.68rem;
            opacity: 0.48;
        }

        .footer-caption {
            font-size: 0.63rem;
            opacity: 0.38;
            margin-top: 3px;
        }

        </style>
        """
        )


# ===========================================================
# BRAND
# ===========================================================

def _render_brand() -> None:
    """Render InsightAI professional branding."""

    st.html(
        """
        <div class="insightai-brand">

            <div class="insightai-logo">
                ◈
            </div>

            <div>
                <div class="insightai-title">
                    InsightAI
                </div>

                <div class="insightai-subtitle">
                    Intelligent Data Analysis
                </div>
            </div>

        </div>
        """
        )


# ===========================================================
# DATASET STATUS
# ===========================================================

def _render_dataset_status() -> None:
    """Render current dataset status."""

    loaded = bool(
        st.session_state.get(
            "data_loaded",
            False,
        )
    )

    filename = st.session_state.get(
        "uploaded_file_name"
    )

    if loaded and filename:

        badge_class = "status-active"
        badge_text = "Dataset Ready"
        badge_icon = "●"

        file_display = filename

    else:

        badge_class = "status-empty"
        badge_text = "No Dataset"
        badge_icon = "○"

        file_display = "Upload a dataset to begin"

    st.html(
        '<div class="sidebar-section-label">'
        'Workspace Status'
        '</div>'
        )

    st.html(
        f"""
        <div class="dataset-status-card">

            <div class="status-row">

                <div class="status-icon">
                    ◉
                </div>

                <div>
                    <div class="status-label">
                        Dataset Status
                    </div>

                    <div class="status-value">
                        <span class="status-badge {badge_class}">
                            <span class="status-dot">
                                {badge_icon}
                            </span>

                            {badge_text}
                        </span>
                    </div>
                </div>

            </div>


            <div class="status-row">

                <div class="status-icon">
                    ▣
                </div>

                <div>
                    <div class="status-label">
                        Current File
                    </div>

                    <div class="status-value">
                        {file_display}
                    </div>
                </div>

            </div>

        </div>
        """
        )


# ===========================================================
# SIDEBAR
# ===========================================================

def render_sidebar() -> str:
    """
    Render the professional application sidebar.

    Returns
    -------
    str
        Selected page.
    """

    init_sidebar_state()

    _inject_sidebar_style()

    current_page = st.session_state.page

    current_index = PAGES.index(
        current_page
    )

    with st.sidebar:

        # ---------------------------------------------------
        # Brand
        # ---------------------------------------------------

        _render_brand()

        st.divider()

        # ---------------------------------------------------
        # Navigation
        # ---------------------------------------------------

        st.html(
            '<div class="sidebar-section-label">'
            'Workspace'
            '</div>'
        )

        selected_page = st.radio(
            "Navigation",
            options=PAGES,
            index=current_index,
            format_func=lambda page: NAVIGATION.get(
                page,
                page,
            ),
            key="nav_radio",
            label_visibility="collapsed",
        )

        st.session_state.page = selected_page

        st.divider()

        # ---------------------------------------------------
        # Dataset Status
        # ---------------------------------------------------

        _render_dataset_status()

        st.divider()

        # ---------------------------------------------------
        # Preferences
        # ---------------------------------------------------

        st.html(
            '<div class="sidebar-section-label">'
            'Preferences'
            '</div>'
        )

        st.checkbox(
            "◐  Dark Mode",
            key="dark_mode",
        )

        st.divider()

        # ---------------------------------------------------
        # Application Controls
        # ---------------------------------------------------

        st.html(
            '<div class="sidebar-section-label">'
            'Application'
            '</div>'
        )

        if st.button(
            "↻  Reset Application",
            use_container_width=True,
        ):

            reset_app_state()

            st.rerun()

        # ---------------------------------------------------
        # Footer
        # ---------------------------------------------------

        st.divider()

        st.html(
            f"""
            <div class="insightai-footer">

                <div class="footer-version">
                    InsightAI • v{APP_VERSION}
                </div>

                <div class="footer-caption">
                    Intelligent Analytics Workspace
                </div>

            </div>
            """
        )

    return selected_page