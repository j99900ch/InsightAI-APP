# ===========================================================
# DATASET METRICS
# ===========================================================

def _get_dataset_metrics() -> dict[str, object]:
    """Safely calculate dashboard dataset metrics."""

    df = st.session_state.get("df")

    if df is None:
        return {
            "rows": 0,
            "columns": 0,
            "numeric": 0,
            "categorical": 0,
            "missing": 0,
        }

    try:
        rows, columns = df.shape

        numeric = len(
            df.select_dtypes(
                include="number"
            ).columns
        )

        categorical = len(
            df.select_dtypes(
                include=[
                    "object",
                    "category",
                    "bool",
                    "string",
                ]
            ).columns
        )

        missing = int(
            df.isna().sum().sum()
        )

        return {
            "rows": rows,
            "columns": columns,
            "numeric": numeric,
            "categorical": categorical,
            "missing": missing,
        }

    except Exception:
        return {
            "rows": 0,
            "columns": 0,
            "numeric": 0,
            "categorical": 0,
            "missing": 0,
        }


# ===========================================================
# METRIC CARD
# ===========================================================

def _render_metric_card(
    column,
    icon: str,
    title: str,
    value: object,
) -> None:
    """Render one dashboard metric card."""

    with column:

        st.html(
            dedent(
                f"""
                <div class="dashboard-card">

                    <div class="dashboard-card-icon">
                        {icon}
                    </div>

                    <div class="dashboard-card-title">
                        {title}
                    </div>

                    <div class="dashboard-card-value">
                        {value}
                    </div>

                </div>
                """
            )
        )


# ===========================================================
# CAPABILITY CARD
# ===========================================================

def _render_capability_card(
    column,
    icon: str,
    title: str,
    description: str,
) -> None:
    """Render one analytics capability card."""

    with column:

        st.html(
            dedent(
                f"""
                <div class="capability-card">

                    <div class="capability-icon">
                        {icon}
                    </div>

                    <div class="capability-title">
                        {title}
                    </div>

                    <div class="capability-text">
                        {description}
                    </div>

                </div>
                """
            )
        )


# ===========================================================
# HERO
# ===========================================================

def _render_hero() -> None:
    """Render the main dashboard hero section."""

    st.html(
        dedent(
            """
            <div class="insight-hero">

                <div class="insight-hero-badge">
                    &#9670; INTELLIGENT ANALYTICS PLATFORM
                </div>

                <div class="insight-hero-title">
                    InsightAI
                </div>

                <div class="insight-hero-subtitle">
                    Transform raw business data into meaningful
                    statistics, visual intelligence, machine-learning
                    predictions, business insights and decision support.
                </div>

            </div>
            """
        )
        )


# ===========================================================
# DATASET STATUS
# ===========================================================

def _render_dataset_status() -> None:
    """Render the current dataset status."""

    filename = st.session_state.get(
        "uploaded_file_name"
    )

    if filename:

        st.html(
            dedent(
                f"""
                <div class="dataset-status">

                    <div class="section-label">
                        ACTIVE DATASET
                    </div>

                    <div class="dataset-name">
                        &#9673; {filename}
                    </div>

                    <div class="dataset-caption">
                        Dataset successfully loaded and ready
                        for analysis.
                    </div>

                </div>
                """
            )
        )

    else:

        st.info(
            "No dataset is currently loaded. "
            "Open **Dataset Overview** from the navigation "
            "panel to upload a CSV or Excel dataset."
        )


# ===========================================================
# DATASET SNAPSHOT
# ===========================================================

def _render_dataset_metrics(
    metrics: dict[str, object],
) -> None:
    """Render high-level dataset metrics."""

    st.html(
        '<div class="section-label">DATA INTELLIGENCE</div>'
        )

    st.html(
        '<div class="section-title">Dataset Snapshot</div>'
        )

    columns = st.columns(5)

    _render_metric_card(
        columns[0],
        "&#9638;",
        "Rows",
        f"{metrics['rows']:,}",
    )

    _render_metric_card(
        columns[1],
        "&#9670;",
        "Columns",
        f"{metrics['columns']:,}",
    )

    _render_metric_card(
        columns[2],
        "&#8721;",
        "Numeric",
        f"{metrics['numeric']:,}",
    )

    _render_metric_card(
        columns[3],
        "&#9672;",
        "Categorical",
        f"{metrics['categorical']:,}",
    )

    _render_metric_card(
        columns[4],
        "&#9651;",
        "Missing",
        f"{metrics['missing']:,}",
    )


# ===========================================================
# CAPABILITIES
# ===========================================================

def _render_capabilities() -> None:
    """Render InsightAI analytics capabilities."""

    st.html(
        '<div class="section-label">ANALYTICS ENGINE</div>'
        )

    st.html(
        '<div class="section-title">What InsightAI Can Do</div>'
        )

    # -------------------------------------------------------
    # ROW 1
    # -------------------------------------------------------

    row_one = st.columns(3)

    _render_capability_card(
        row_one[0],
        "&#9672;",
        "Dataset Intelligence",
        "Profile datasets, inspect structure, identify "
        "missing values, duplicates and data-quality signals.",
    )

    _render_capability_card(
        row_one[1],
        "&#8721;",
        "Advanced Statistics",
        "Generate descriptive, numeric and categorical "
        "statistics for deeper dataset understanding.",
    )

    _render_capability_card(
        row_one[2],
        "&#9670;",
        "Visual Analytics",
        "Explore distributions, relationships, trends, "
        "categories and correlations through interactive charts.",
    )

    st.write("")

    # -------------------------------------------------------
    # ROW 2
    # -------------------------------------------------------

    row_two = st.columns(3)

    _render_capability_card(
        row_two[0],
        "&#9671;",
        "Machine Learning",
        "Train classification and regression models, "
        "compare algorithms and generate predictions.",
    )

    _render_capability_card(
        row_two[1],
        "&#9673;",
        "Business Insights",
        "Translate analytical results into practical "
        "business observations and opportunities.",
    )

    _render_capability_card(
        row_two[2],
        "&#9670;",
        "Decision Intelligence",
        "Combine forecasting, business rules and decision "
        "signals to support more informed decisions.",
    )

    st.write("")

    # -------------------------------------------------------
    # ROW 3
    # -------------------------------------------------------

    row_three = st.columns(3)

    _render_capability_card(
        row_three[0],
        "&#9673;",
        "Voice Interaction",
        "Ask supported business questions through voice "
        "input instead of typing them manually.",
    )

    _render_capability_card(
        row_three[1],
        "&#8599;",
        "Forecasting",
        "Analyze historical trends and generate future "
        "business forecasts for planning.",
    )

    _render_capability_card(
        row_three[2],
        "&#9632;",
        "Professional Reports",
        "Generate structured analytical reports and "
        "export important results for business use.",
    )


# ===========================================================
# DATASET SUMMARY
# ===========================================================

def _render_dataset_summary() -> None:
    """Render the existing dataset summary."""

    summary = st.session_state.get(
        "dataset_summary",
        {},
    )

    if not summary:
        return

    st.html(
        '<div class="section-label">BUSINESS CONTEXT</div>'
        )

    st.html(
        '<div class="section-title">Dataset Summary</div>'
        )

    items = list(summary.items())

    if not items:
        return

    columns = st.columns(2)

    midpoint = (
        len(items) + 1
    ) // 2

    with columns[0]:

        for key, value in items[:midpoint]:

            st.metric(
                label=str(key)
                .replace("_", " ")
                .title(),
                value=value,
            )

    with columns[1]:

        for key, value in items[midpoint:]:

            st.metric(
                label=str(key)
                .replace("_", " ")
                .title(),
                value=value,
            )


# ===========================================================
# MAIN DASHBOARD
# ===========================================================

def render_dashboard() -> None:
    """
    Render the complete InsightAI dashboard.

    This function does not modify navigation
    or page routing.
    """

    _inject_dashboard_styles()

    _render_hero()

    metrics = _get_dataset_metrics()

    _render_dataset_status()

    st.divider()

    _render_dataset_metrics(
        metrics
    )

    st.divider()

    _render_capabilities()

    _render_dataset_summary()

    st.html(
        dedent(
            """
            <div class="dashboard-footer">
                InsightAI Professional Analytics Platform
                • Version 2.0
                • Data → Intelligence → Decisions
            </div>
            """
        )
        )